{
    "name": "edifonttes/php-router",
    "description": "Sistema de roteamento PHP simples, poderoso e flexível com suporte a grupos, middlewares e parâmetros dinâmicos",
    "type": "library",
    "keywords": ["router", "routing", "php", "middleware", "mvc"],
    "license": "MIT",
    "authors": [
        {
            "name": "Edivan Fontes",
            "email": "ebezerradevelopment@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "PHPRouter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPRouter\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}